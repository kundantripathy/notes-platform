# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/notes_platform

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=np_token

# ---- Razorpay (use Test Mode keys first; the secret never goes to the client) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Public key only — safe to expose to the browser
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---- Business contact (shown on Razorpay checkout) ----
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+910000000000

# ---- Secure file storage (private dir, never served statically) ----
PRIVATE_FILES_DIR=./uploads
DOWNLOAD_URL_TTL_SECONDS=300
DEFAULT_DOWNLOAD_LIMIT=5

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Notes Store <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com
